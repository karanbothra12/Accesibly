# Accessly — environment variables (set these in Vercel → Project → Settings → Environment Variables)

# Postgres connection string (Neon). Required.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# iron-session cookie encryption secret — must be at least 32 characters. Required.
SESSION_SECRET=change-me-to-a-long-random-32char-plus-secret

# Public site URL used for canonical/OG/sitemap/robots. Recommended in production.
NEXT_PUBLIC_SITE_URL=https://accessly.io

# Email delivery (optional until go-live). When set, queued notifications send via Resend.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Accessly <noreply@accessly.io>

# Dedicated token for the internal audit-reclaim endpoint (/api/audits/<id>/run).
# Falls back to SESSION_SECRET if unset; set a distinct value in production.
# INTERNAL_TOKEN=another-long-random-secret

# Self-hosted W3C "Nu Html Checker" (vnu) for HTML validation audits.
# Deploy it as a service — Docker: `docker run -d -p 8888:8888 validator/validator`,
# or `java -Xss1m -jar vnu.jar --server` — and point this at its base URL.
# When unset, HTML validation jobs fail with a clear "checker not configured" message.
# VNU_URL=http://localhost:8888

# Self-hosted W3C CSS Validator (Jigsaw) for CSS validation audits.
# Point this at the `validator` servlet of your running CSS validator.
# When unset, CSS validation jobs fail with a clear "validator not reachable" message.
# CSS_VALIDATOR_URL=http://localhost:8888/css-validator/validator

# Background crawl worker. When a dedicated worker (npm run worker, hosted off
# Vercel) is deployed, set this to 1 on the WEB app so crawls are left queued for
# the worker instead of running in-process (avoids the serverless time limit on
# large full-site crawls). Leave unset to run crawls in-process (fine for small
# crawls / single deployments).
# CRAWL_WORKER_ENABLED=1
# Worker tuning (set on the WORKER, optional): poll interval + stalled-job recovery.
# WORKER_POLL_MS=5000
# WORKER_STALL_MINUTES=15

# Identifiable user-agent the audit crawler sends, so customers can allowlist
# Accessly in their WAF/CDN (default headless Chromium is usually bot-blocked).
# AUDIT_USER_AGENT=AccesslyAuditBot/1.0 (+https://accessly.io/bot)

# Set to 1 to allow auditing private/localhost targets in production (NOT recommended).
# ALLOW_PRIVATE_TARGETS=0
# Set to 1 to allow self-serve plan upgrades without payment (dev/testing only).
# ALLOW_FREE_PLAN_UPGRADES=0
