# ── Accessly worker/agent environment ─────────────────────────────────────────
# Copy to `.env` on the host and fill in REAL values:   cp .env.worker.example .env
# NEVER commit the real .env (it is gitignored). Rotate any secret that leaked.

# ── Required ──────────────────────────────────────────────────────────────────
# Neon pooled connection string (same DB as Vercel). Keep the SSL params.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Strongly recommended ──────────────────────────────────────────────────────
# ISP / ASN / geo enrichment (same token as Vercel). Free tier is plenty.
IPINFO_TOKEN=

# Same values as on Vercel (used for callbacks + cookie/session compatibility).
SESSION_SECRET=
INTERNAL_TOKEN=

# ── Email / alerts (optional — alerts queue until one of these is set) ─────────
RESEND_API_KEY=
EMAIL_FROM=alerts@yourdomain.com
# …or use SMTP instead of Resend:
# SMTP_URL=smtp://user:pass@smtp.host:587

# ── Optional: self-hosted CSS validator (see docker-compose.yml) ──────────────
# CSS_VALIDATOR_URL=http://css:8888/css-validator/validator

# ── Optional: MaxMind GeoLite2 instead of IPinfo ──────────────────────────────
# MAXMIND_ASN_DB=/data/GeoLite2-ASN.mmdb
# MAXMIND_CITY_DB=/data/GeoLite2-City.mmdb

# ── Do NOT set in production ───────────────────────────────────────────────────
# ALLOW_PRIVATE_TARGETS   # SSRF guard escape hatch — leave unset
