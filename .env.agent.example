# ── Remote agent environment ──────────────────────────────────────────────────
# Copy to `.env.agent` on the agent host and fill in real values.
# NEVER commit the real file.

# The central app's public URL (your Vercel deployment).
MONITORING_API_URL=https://accesibly.vercel.app

# This agent's bearer token — shown ONCE at registration in
# Admin → Internet Monitoring → Agents → Add agent. Copy it immediately.
AGENT_TOKEN=

# Optional tuning:
# AGENT_POLL_MS=5000
# AGENT_HEARTBEAT_MS=30000
